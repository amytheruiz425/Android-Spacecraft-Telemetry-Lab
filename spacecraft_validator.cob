IDENTIFICATION DIVISION.
PROGRAM-ID. SPACECRAFT-VALIDATOR.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT INPUT-FILE
        ASSIGN TO "spacecraft_telemetry.txt"
        ORGANIZATION IS LINE SEQUENTIAL.
    SELECT OUTPUT-FILE
        ASSIGN TO "validated_spacecraft.txt"
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD INPUT-FILE.
01 INPUT-RECORD PIC X(16).

FD OUTPUT-FILE.
01 OUTPUT-RECORD PIC X(16).

WORKING-STORAGE SECTION.
01 TELEMETRY-RECORD.
   05 VEHICLE-ID       PIC X(6).
   05 BATTERY-TEXT     PIC X(3).
   05 TEMPERATURE-TEXT PIC X(3).
   05 SIGNAL-TEXT      PIC X(3).
   05 ALERT-CODE       PIC X.

01 BATTERY-VALUE     PIC 9(3).
01 TEMPERATURE-VALUE PIC 9(3).
01 SIGNAL-VALUE      PIC 9(3).

01 END-OF-FILE PIC X VALUE "N".
   88 NO-MORE-RECORDS VALUE "Y".

01 ACCEPTED-COUNT PIC 9(2) VALUE ZERO.
01 REJECTED-COUNT PIC 9(2) VALUE ZERO.

PROCEDURE DIVISION.
    OPEN INPUT INPUT-FILE
    OPEN OUTPUT OUTPUT-FILE

    PERFORM UNTIL NO-MORE-RECORDS
        READ INPUT-FILE
            AT END
                SET NO-MORE-RECORDS TO TRUE
            NOT AT END
                MOVE INPUT-RECORD TO TELEMETRY-RECORD
                PERFORM VALIDATE-RECORD
        END-READ
    END-PERFORM

    CLOSE INPUT-FILE OUTPUT-FILE

    DISPLAY "SPACECRAFT VALIDATION COMPLETE"
    DISPLAY "ACCEPTED: " ACCEPTED-COUNT
    DISPLAY "REJECTED: " REJECTED-COUNT
    STOP RUN.

VALIDATE-RECORD.
    IF BATTERY-TEXT IS NUMERIC
       AND TEMPERATURE-TEXT IS NUMERIC
       AND SIGNAL-TEXT IS NUMERIC
       AND (ALERT-CODE = "N"
            OR ALERT-CODE = "W"
            OR ALERT-CODE = "A")
        MOVE BATTERY-TEXT TO BATTERY-VALUE
        MOVE TEMPERATURE-TEXT TO TEMPERATURE-VALUE
        MOVE SIGNAL-TEXT TO SIGNAL-VALUE

        IF BATTERY-VALUE <= 100
           AND TEMPERATURE-VALUE <= 150
           AND SIGNAL-VALUE <= 100
            MOVE TELEMETRY-RECORD TO OUTPUT-RECORD
            WRITE OUTPUT-RECORD
            ADD 1 TO ACCEPTED-COUNT
        ELSE
            ADD 1 TO REJECTED-COUNT
        END-IF
    ELSE
        ADD 1 TO REJECTED-COUNT
    END-IF.
